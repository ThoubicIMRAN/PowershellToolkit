+@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=DM+Sans:wght@400;500;600;700;800&display=swap');
+
+/* ══ DESIGN TOKENS (single source of truth — mirrors PowerShell_Toolkit_v4 reference) ══ */
+:root{
+  --bg:#080d18;--panel:#0e1525;--card:#121b2e;--card2:#162035;
+  --border:#1c2d47;--border2:#243450;
+  --blue:#3b82f6;--blue-d:#1d4ed8;--blue-g:rgba(59,130,246,.12);
+  --cyan:#22d3ee;--green:#34d399;--yellow:#fbbf24;
+  --red:#f87171;--orange:#fb923c;--purple:#a78bfa;--pink:#f472b6;
+  --text:#dde6f5;--text2:#94a3b8;--text3:#4b6080;
+  --mono:'JetBrains Mono',ui-monospace,Consolas,monospace;
+  --sans:'DM Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
+  --r6:6px;--r8:8px;--r10:10px;--r12:12px;--r14:14px;
+  --shadow:0 8px 32px rgba(0,0,0,.6);
+  --card-h:240px;
+}
+
+/* ══ GLOBAL ══ */
+.stApp,.stApp p,.stApp label,.stApp button,.stApp input,.stApp textarea,.stApp h1,.stApp h2,.stApp h3,.stApp h4,.stApp li,.stApp td,.stApp th,[data-baseweb]{font-family:var(--sans)}
+[data-testid="stIconMaterial"],.material-icons,[class*="material-symbols"]{font-family:"Material Symbols Rounded","Material Symbols Outlined"!important}
+.stApp{background:var(--bg);color:var(--text)}
+[data-testid="stHeader"]{background:transparent}
+[data-testid="stMainBlockContainer"],.stMainBlockContainer{max-width:none;padding:3.2rem 1.1rem 2rem!important}
+h1,h2,h3,h4{font-family:var(--sans)!important;color:var(--text);font-weight:700;letter-spacing:0}
+[data-testid="stMainBlockContainer"] h1{font-size:1.5rem;padding:.2rem 0 .6rem}
+[data-testid="stMainBlockContainer"] h3{font-size:1.05rem}
+::-webkit-scrollbar{width:5px;height:5px}
+::-webkit-scrollbar-track{background:transparent}
+::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}
+::-webkit-scrollbar-thumb:hover{background:#2e4268}
+[data-testid="stVerticalBlock"]{gap:.5rem}
+
+/* ══ SIDEBAR ══ */
+[data-testid="stSidebar"]{background:var(--panel);border-right:1px solid var(--border)}
+[data-testid="stSidebarContent"]{padding:0}
+[data-testid="stSidebarHeader"]{height:2.4rem;min-height:0;padding:.4rem .6rem;margin:0}
+[data-testid="stSidebarUserContent"]{padding:0!important}
+[data-testid="stSidebar"] [data-testid="stVerticalBlock"]{gap:0}
+.s-logo{padding:16px 14px 14px;border-bottom:1px solid var(--border);
+  background:linear-gradient(135deg,rgba(59,130,246,.08),transparent)}
+.s-logo h1{font-size:13px!important;font-weight:800;letter-spacing:.07em;text-transform:uppercase;
+  color:var(--cyan)!important;line-height:1.2;margin:0;padding:0}
+.s-logo p{font-size:10px;color:var(--text3);font-family:var(--mono);margin:3px 0 0}
